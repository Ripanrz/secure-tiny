# Pengaturan proyek Quartus: family, device, top-level, SDC, dan sumber RTL.
# MAX_DATA_BYTES=16 adalah konfigurasi baseline, bukan batas algoritma Ascon.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY secure_tiny_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE secure_tiny.sdc
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ascon_permutation.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ascon_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/tag_generator.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/tag_verifier.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/authentication_guard.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/aead_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/secure_tiny_top.sv
set_parameter -name MAX_DATA_BYTES 16

# Pin board DE10-Nano untuk clock FPGA_CLK1_50 dan tombol reset KEY[0].
set_location_assignment PIN_V11 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_location_assignment PIN_AH17 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n

# Port transaksi masih virtual untuk sintesis; belum terhubung ke HPS,
# header ekspansi, atau pin fisik untuk uji transaksi board.
set_instance_assignment -name VIRTUAL_PIN ON -to start
set_instance_assignment -name VIRTUAL_PIN ON -to decrypt
set_instance_assignment -name VIRTUAL_PIN ON -to "key[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "nonce[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "ad_length[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "data_length[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "received_tag[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to ad_valid
set_instance_assignment -name VIRTUAL_PIN ON -to ad_ready
set_instance_assignment -name VIRTUAL_PIN ON -to "ad_data[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to data_valid
set_instance_assignment -name VIRTUAL_PIN ON -to data_ready
set_instance_assignment -name VIRTUAL_PIN ON -to "data_in[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to out_valid
set_instance_assignment -name VIRTUAL_PIN ON -to out_ready
set_instance_assignment -name VIRTUAL_PIN ON -to "out_data[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to tag_valid
set_instance_assignment -name VIRTUAL_PIN ON -to tag_ready
set_instance_assignment -name VIRTUAL_PIN ON -to "tag_out[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to auth_result_valid
set_instance_assignment -name VIRTUAL_PIN ON -to accept
set_instance_assignment -name VIRTUAL_PIN ON -to reject
set_instance_assignment -name VIRTUAL_PIN ON -to busy
set_instance_assignment -name VIRTUAL_PIN ON -to done
set_instance_assignment -name VIRTUAL_PIN ON -to command_error

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"